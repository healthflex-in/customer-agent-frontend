# Every VITE_* value is embedded in the browser bundle and must be treated as
# public configuration. Never place a server-side secret in this file.
VITE_APP_ENV=local
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_GRAPHQL_URL=https://api.example.invalid/graphql
VITE_CONSENT_URL=https://dev.consent.stance.health
VITE_API_KEY=replace-with-a-restricted-browser-application-key
VITE_ORGANIZATION_ID=replace-with-the-public-organization-id
