FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_APP_ENV
ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_GRAPHQL_URL
ARG VITE_CONSENT_URL
ARG VITE_ALLOW_INSECURE_DEV_IP
ARG VITE_API_KEY
ARG VITE_ORGANIZATION_ID

ENV VITE_APP_ENV=${VITE_APP_ENV} \
    VITE_API_URL=${VITE_API_URL} \
    VITE_WS_URL=${VITE_WS_URL} \
    VITE_GRAPHQL_URL=${VITE_GRAPHQL_URL} \
    VITE_CONSENT_URL=${VITE_CONSENT_URL} \
    VITE_ALLOW_INSECURE_DEV_IP=${VITE_ALLOW_INSECURE_DEV_IP} \
    VITE_API_KEY=${VITE_API_KEY} \
    VITE_ORGANIZATION_ID=${VITE_ORGANIZATION_ID}

RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY nginx.dev.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
